# Base64-encoded CSV data for playlist tracks
# Generate with: base64 -i BPdata_89_Current.csv
VITE_PLAYLIST_DATA=your_base64_encoded_csv_here

# Web3Forms access key for the footer contact form (free at https://web3forms.com)
# Without it the footer falls back to the external contact link.
VITE_WEB3FORMS_KEY=your_web3forms_access_key_here
